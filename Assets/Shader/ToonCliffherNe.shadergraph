{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "cd973057cbd1499b9090103103f52ccc",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CalculateAdditionalLights (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2310.000244140625,
            "y": 213.00003051757813,
            "width": 299.0001220703125,
            "height": 190.00006103515626
        }
    },
    "m_Slots": [
        {
            "m_Id": "a664ef45b64341f48b77ec3a4795b0fe"
        },
        {
            "m_Id": "908c52a90dbf450597a1fb3c819ab484"
        },
        {
            "m_Id": "165da85b68674975b01c9c8069b71dd1"
        },
        {
            "m_Id": "bb66643bf69445698ff6d121ae6b8fb1"
        },
        {
            "m_Id": "511e5203ecad49218a34bd315e12fdcd"
        },
        {
            "m_Id": "e7144fa24d3e450f8dbeeded54ea9164"
        },
        {
            "m_Id": "fcab2368e21f4aee8a80f3f062b8a6b0"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "CalculateAdditionalLights",
    "m_FunctionSource": "163cc8e91cf4d5f4e93fcfc09a8f6e99",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Diffuse = 0;\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    int pixelLightCount = GetAdditionalLightsCount();\r\n    for (int i = 0; i < pixelLightCount; ++i)\r\n    {\r\n        // 1. Obtener datos de la luz (posicion, color, atenuación)\r\n        Light light = GetAdditionalLight(i, WorldPos);\r\n        // 2. Calcular el producto punto (NdotL)\r\n        half d = dot(WorldNormal, light.direction);\r\n        // 3. Aplicar el Toon Step (esto hace que la luz sea sólida, no suave)\r\n        // Usamos smoothstep para que el borde no sea \"serruchado\" (aliasing)\r\n        half toonStep = smoothstep(0.0, 0.05, d); \r\n        // 4. Combinar con la atenuación de distancia y sombras\r\n        half attenuation = light.distanceAttenuation * light.shadowAttenuation; \r\n        // 5. Sumar al total\r\n        Diffuse += light.color * (toonStep * attenuation);\r\n    }\r\n#endif"
}

